# Builds cmd/api. Multi-stage so the shipped image is the static binary
# plus a minimal base, not the Go toolchain, not go.mod's module cache.
#
# Verified with a real docker build now, in the full compose stack, and
# it is worth saying why that mattered: this pinned golang:1.24-alpine
# while go.mod had moved to 1.25, so every docker build failed with
# "go.mod requires go >= 1.25.0". Nothing caught it, because go build,
# go vet and go test all run against the host toolchain and never touch
# this file. Keep this base image in step with go.mod.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 go build -o /out/nia-api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/nia-api /usr/local/bin/nia-api
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O- http://localhost:8080/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/nia-api"]
